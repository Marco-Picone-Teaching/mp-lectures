flowchart LR
 subgraph UI["Web UIs"]
        A3["User Web UI"]
        A4["Manager Web UI"]
  end
 subgraph API["API Gateway"]
        G["API Gateway"]
  end
 subgraph BE["Backend Microservices"]
        DM["Device Management<br>RESTful Service"]
        DT@{ label: "Data Management<span style=\"padding-left:\"><br>RESTful Service</span>" }
        AN@{ label: "Analytics<br><span style=\"padding-left:\">RESTful Service</span>" }
        NO@{ label: "Notification<span style=\"padding-left:\"><br>RESTful Service</span>" }
  end
 subgraph AD["Notification Adapters"]
        PN["Push Notification Adapter"]
        EM["Email Adapter"]
  end
    A1(["IoT Devices"]) -- Send telemetry / Request actions --> G
    A2(["Third-party Applications"]) -- Invoke REST APIs --> G
    A3 -- View data / Interact --> G
    A4 -- Device mgmt / Admin ops --> G
    G -- Forward authenticated call --> DM & DT & AN & NO
    AN -- Query device info --> DM
    AN -- Query / Ingest data --> DT
    AN -- Trigger alarms --> NO
    NO -- Send push event --> PN
    NO -- Send email event --> EM
    n1(["User"]) --> A3
    n2(["Manager"]) --> A4

    G@{ shape: diam}
    DM@{ shape: hex}
    DT@{ shape: hex}
    AN@{ shape: hex}
    NO@{ shape: hex}
    style G fill:#BBDEFB
    style DM fill:#00C853
    style DT fill:#00C853
    style AN fill:#00C853
    style NO fill:#00C853
    style UI fill:#FFFFFF


